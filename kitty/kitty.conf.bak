include kitty.templates.conf

# Shell Setup
shell /bin/zsh

# BEGIN_KITTY_THEME
# Mayukai
#include current-theme.conf

fastfetch
# END_KITTY_THEME

# Font Setup
font_family    JetBrainsMono Nerd Font
bold_font         auto
italic_font       auto
bold_italic_font  auto
font_size         15.0

# Window Layout
window_padding_width 15
confirm_os_window_close 0
macos_traditional_fullscreen yes

# Opacity & Blur (Placed at the bottom so it overrides the theme)
background_opacity 0.65
dynamic_background_opacity yes
background_blur 1

# Performance
repaint_delay 10
input_delay 3
sync_to_monitor yes
#background_image ~/Downloads/mai3.png

#background_image_layout tiled 
#(options include tiled, mirror-tiled, scaled, clamped

background_tint 0.8
cursor_shape block
cursor_trail 1
cursor_trail_start_threshold 0
shell_integration no-cursor
