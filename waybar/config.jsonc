{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "margin-top": 25,
    "margin-left": 21,
    "margin-right": 21,
    "height": 34,
   "modules-left": [],
    "modules-right": [
        "tray"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "pulseaudio",
        "network",
        "battery"
    ],

   "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
        "*": 5 
    }
},

   "clock": {
        "format": "{:%I:%M %p}", // Added the icon here
        "format-alt": "{:%A, %B %d}",
        "tooltip": true,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>"            }
        }
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "tooltip": true
    },
    "memory": {
        "interval": 2,
        "format": "  {}%" 
    },
    "battery": {

    "states": {
        "warning": 30,
        "critical": 15
    },
"format":  "{icon}   {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": " ", 
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  },

    "betwork": {
        "interval": 2,
        "format-wifi": "   {bandwidthDownBytes} >>>  {bandwidthUpBytes}",
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "tooltip-format": "{essid}"
    },
    "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟 ",
    "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾 "]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{volume}%",
    "tooltip": true,
    "scroll-step": 5
},
"network": {
    "format-wifi": "{icon} ",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format": "{essid}",
    "max-length": 40
}
}
